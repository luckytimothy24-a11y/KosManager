APP_NAME=KosManager
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# Dibuat otomatis oleh docker/entrypoint.sh bila kosong.
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kosmanager
DB_USERNAME=kosmanager
DB_PASSWORD=secret

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@kosmanager.test
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_DRIVER=log

# Isi dengan key produksi. Kosong = push notification nonaktif.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kosmanager.test

# Wajib untuk audit log. Kosong = dibuat otomatis saat container start.
AUDIT_LOG_HMAC_SECRET=

# Wajib bila memakai payment gateway; demo sandbox tidak memanggil gateway.
PAYMENT_GATEWAY=sandbox
PAYMENT_GATEWAY_WEBHOOK_KEY=
